									Margin="1"
									BorderThickness="2" BorderBrush="White" Background="White" 
									Height="20" ToolTipOpening="FailureSquareToolTipOpening"
										MouseEnter="FailureSquareMouseEnter" MouseLeave="FailureSquareMouseLeave">
										<Border.ToolTip>
											<ToolTip>
												<TextBlock FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" Text="{Binding TooltipText}" />
											</ToolTip>
										</Border.ToolTip>
										<Rectangle Fill="{StaticResource BarColor}" Stroke="Transparent" Opacity="{Binding FailurePercentage, Converter={StaticResource FailureRateToOpacity}, Mode=OneWay}"/>
									</Border>
								</Grid>
							</DataTemplate>
							<Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="{x:Type Button}">
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="{x:Type Button}">
											<Grid Background="{StaticResource FrameBackground}"/>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</DataGrid.Resources>
					</DataGrid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Window>
