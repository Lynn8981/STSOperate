<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:STSOperatorTool"
		xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
		xmlns:s="clr-namespace:System;assembly=mscorlib"
		mc:Ignorable="d"
		Loaded="MainWindow_OnLoaded" d:DataContext="{d:DesignData IViewModel}"
		x:Class="STSOperatorTool.MainWindow"
		x:Name="STSOperatorToolWindow"
		WindowStyle="None"
		Title="STS_OPERATOR_TOOL_NAME" Height="Auto" Width="1400" MinWidth="800" MinHeight="345"
		WindowStartupLocation="CenterScreen"
		SizeChanged="MainWindow_SizeChanged" Closing="MainWindow_OnClosing">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			ResizeBorderThickness="6"
			CaptionHeight="43"
			CornerRadius="0"
			GlassFrameThickness="0">
		</shell:WindowChrome>
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<local:FailureRateToOpacityConverter x:Key="FailureRateToOpacity" />
		<local:InvertBooleanConverter x:Key="Invert" />
		<local:PercentageConverter x:Key="Percentage" />
		<GridLength x:Key="RowHeight">56</GridLength>
		<s:Double x:Key="MinCardHeight">234</s:Double>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
		<Style TargetType="TextBlock">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{StaticResource TextColor}"/>
		</Style>
		<Style TargetType="MenuItem">
			<Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
			<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
		</Style>
		<Style TargetType="ToolTip">
			<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoColor}}" />
			<Style.Resources>
				<!-- need to override the "TextBlock" foreground color set earlier -->
				<Style TargetType="TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextColor}}"/>
				</Style>
			</Style.Resources>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!--provide the background for the entire form.  In practice, this appears as the window's resize border, because the title and window content obscure the rest-->
		<Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="0" BorderThickness="0.5" BorderBrush="{StaticResource WindowFrameColor}" Background="{StaticResource FrameBackground}" />

		<!--title bar-->
		<Grid Grid.Row="0" Height="40" Margin="{Binding ElementName=STSOperatorToolWindow, Path=CaptionButtonMargin}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<!--Window Icon and Title-->
			<local:WindowIcon Grid.Column="0" Width="16" Height="16" Margin="16,0,16,0" />
			<TextBlock Grid.Column="1" Text="{Binding Title, ElementName=STSOperatorToolWindow}" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>

			<local:MinimizeButton Grid.Column="2" Content="{StaticResource MinimizeIcon}" Style="{StaticResource CaptionButtonStyle}"/>
			<local:MaximizeButton Grid.Column="3" Content="{StaticResource Maximize1Icon}" Style="{StaticResource CaptionButtonStyle}" x:Name="Maximize1Button"/>
			<local:MaximizeButton Grid.Column="3" Content="{StaticResource Maximize2Icon}" Style="{StaticResource CaptionButtonStyle}" x:Name="Maximize2Button" Visibility="Hidden"/>
			<local:CloseButton Grid.Column="4" Content="{StaticResource CloseIcon}" Style="{StaticResource CaptionButtonStyle}" Command="{Binding ExitCommand}"/>
		</Grid>

		<Grid Grid.Row="1" Margin="32,0,32,8" Grid.IsSharedSizeScope="True">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!-- Menu bar Grid control -->
			<Grid Grid.Row="0" Grid.IsSharedSizeScope="True" x:Name="MenuBarGrid">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" MinWidth="{Binding Path=DesiredSize.Width, ElementName=UserIcon}"/>
				</Grid.ColumnDefinitions>

				<Grid Grid.Row="0" Background="{StaticResource FrameBackground}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Button Grid.Column="0" Style="{StaticResource Menu}" x:Name="HamburgerButton" HorizontalAlignment="Left" VerticalAlignment="Top" Height="70" Width="70"
					ContextMenuService.Placement="Bottom" local:ContextMenuLeftClickBehavior.IsLeftClickEnabled="True">
						<Button.ContextMenu>
							<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontSize="{StaticResource ContentFontSize}" FontFamily="{StaticResource ContentFont}">
								<MenuItem x:Name="ConfigureLotMenuItem" Header="{Binding ConfigureLotCommand.SemiconductorModuleCommandText}" Command="{Binding ConfigureLotCommand}" Margin="0,16,0,11"
										UsesItemContainerTemplate="{Binding LotConfigured, Converter={StaticResource Invert}}">
									<ToolTipService.ToolTip>
										<TextBlock Text="{Binding ConfigureLotCommand.SemiconductorModuleCommandToolTipText}" />
									</ToolTipService.ToolTip>
								</MenuItem>
								<MenuItem Header="{Binding ConfigureStationCommand.SemiconductorModuleCommandText}" Command="{Binding ConfigureStationCommand}" Margin="0,0,0,11">
									<ToolTipService.ToolTip>
										<TextBlock Text="{Binding ConfigureStationCommand.SemiconductorModuleCommandToolTipText}"/>
									</ToolTipService.ToolTip>
								</MenuItem>
								<Separator Margin="0,0,0,8"/>
								<MenuItem Header="{Binding ViewMidLotSummaryCommand.SemiconductorModuleCommandText}" Command="{Binding ViewMidLotSummaryCommand}" Margin="0,0,0,11">
									<ToolTipService.ToolTip>
										<TextBlock Text="{Binding ViewMidLotSummaryCommand.SemiconductorModuleCommandToolTipText}"/>
									</ToolTipService.ToolTip>
								</MenuItem>
								<MenuItem Header="{Binding ViewReportCommand.SemiconductorModuleCommandText}" Command="{Binding ViewReportCommand}" Margin="0,0,0,11">
									<ToolTipService.ToolTip>
										<TextBlock Text="{Binding ViewReportCommand.SemiconductorModuleCommandToolTipText}"/>
									</ToolTipService.ToolTip>
								</MenuItem>
								<Separator Margin="0,0,0,8"/>
								<MenuItem Header="{Binding OpenSTSMaintenanceSoftwareCommand.SemiconductorModuleCommandText}" Command="{Binding OpenSTSMaintenanceSoftwareCommand}" Margin="0,0,0,16">
									<ToolTipService.ToolTip>
										<TextBlock Text="{Binding OpenSTSMaintenanceSoftwareCommand.SemiconductorModuleCommandToolTipText}"/>
									</ToolTipService.ToolTip>
								</MenuItem>
							</ContextMenu>
						</Button.ContextMenu>
					</Button>
					<Button Grid.Column="2" Style="{StaticResource RunOnce}" x:Name="RunOnce" HorizontalAlignment="Left" VerticalAlignment="Top"
							Width="70" Height="70" Margin="20,0,0,0" Command="{Binding RunOnceCommand}">
						<ToolTipService.ToolTip>
							<TextBlock Text="{Binding RunOnceCommand.SemiconductorModuleCommandToolTipText}"/>
						</ToolTipService.ToolTip>
					</Button>
					<Button Grid.Column="3" Style="{StaticResource StartResumeLot}" x:Name="StartLot" HorizontalAlignment="Left" VerticalAlignment="Top"
							Width="70" Height="70" Margin="0,0" Command="{Binding StartResumeLotCommand}">
						<ToolTipService.ToolTip>
							<TextBlock Text="{Binding StartResumeLotCommand.SemiconductorModuleCommandToolTipText}"/>
						</ToolTipService.ToolTip>
					</Button>
					<Button Grid.Column="4" Style="{StaticResource PauseLot}" x:Name="PauseResumeLot" HorizontalAlignment="Left" VerticalAlignment="Top"
							Width="70" Height="70" Margin="0,0" Command="{Binding PauseLotCommand}">
						<ToolTipService.ToolTip>
							<TextBlock Text="{Binding PauseLotCommand.SemiconductorModuleCommandToolTipText}"/>
						</ToolTipService.ToolTip>
					</Button>
					<Button Grid.Column="5" Style="{StaticResource EndLot}" x:Name="EndLot" HorizontalAlignment="Left" VerticalAlignment="Top" 
							Width="70" Height="70" Margin="0,0" Command="{Binding EndLotCommand}">
						<ToolTipService.ToolTip>
							<TextBlock Text="{Binding EndLotCommand.SemiconductorModuleCommandToolTipText}"/>
						</ToolTipService.ToolTip>
					</Button>
				</Grid>

				<TextBlock Grid.Column="1" Text="{Binding TesterStatus}" Margin="5,0,0,3" VerticalAlignment="Center" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}" />
				
				<Grid Grid.Row="0" Grid.Column="2" Background="{StaticResource FrameBackground}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid Grid.Column="0" x:Name="InlineQAGrid" Margin="0,0,0,3" Visibility="{Binding InlineQAEnabled, Converter={StaticResource BoolToVis}}">
						<Grid.Resources>
							<Style TargetType="TextBlock" />
						</Grid.Resources>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid Grid.Column="0" x:Name="InlineQAWarningBlock" Width="32" Height="32" HorizontalAlignment="Left">
							<Rectangle>
								<Rectangle.Style>
									<Style TargetType="Rectangle">
										<Style.Triggers>
											<DataTrigger Binding="{Binding QAWarning, Mode=OneWay}" Value="True">
												<Setter Property="Fill" Value="{StaticResource WarningColor}"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding QAWarning, Mode=OneWay}" Value="False">
												<Setter Property="Fill" Value="Green"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Rectangle.Style>
							</Rectangle>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding}" Margin="0,4,8,0">
								<ContentPresenter.Style>
									<Style TargetType="ContentPresenter">
										<Style.Triggers>
											<DataTrigger Binding="{Binding QAWarning, Mode=OneWay}" Value="True">
												<Setter Property="ContentTemplate" Value="{StaticResource ExclamationTemplate}" />
												<Setter Property="RenderTransform">
													<Setter.Value>
														<TransformGroup>
															<ScaleTransform ScaleX="0.75" ScaleY="0.75" />
															<TranslateTransform X="5" Y="-1" />
														</TransformGroup>
													</Setter.Value>
												</Setter>
											</DataTrigger>
											<DataTrigger Binding="{Binding QAWarning, Mode=OneWay}" Value="False">
												<Setter Property="ContentTemplate" Value="{StaticResource CheckMarkTemplate}" />
												<Setter Property="RenderTransform">
													<Setter.Value>
														<TransformGroup>
															<ScaleTransform ScaleX="0.75" ScaleY="0.75" />
															<TranslateTransform X="7" Y="-1" />
														</TransformGroup>
													</Setter.Value>
												</Setter>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ContentPresenter.Style>
							</ContentPresenter>
						</Grid>
						<TextBlock Grid.Column="1" Text="{Binding InlineQAPartCountStatistics.Failed, Mode=OneWay, StringFormat=[{0}]}" VerticalAlignment="Center" Margin="5,0,0,3"/>
						<TextBlock Grid.Column="2" x:Name="QAFailedLabel" Text="INLINE_QA_FAILURES" Margin="4,0,24,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}"/>
					</Grid>
					<TextBlock Grid.Column="1" Text="{Binding UserLevelDisplayName}" VerticalAlignment="Center" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UserLevelDisplayName}" HorizontalAlignment="Right"/>
					<Button Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" ContextMenuService.Placement="Bottom" local:ContextMenuLeftClickBehavior.IsLeftClickEnabled="True" x:Name="UserIcon">
						<Button.Content>
							<ContentPresenter Content="{DynamicResource UserIcon}" />
						</Button.Content>
						<Button.ContextMenu>
							<ContextMenu x:Name="LogInLogOutContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontSize="{StaticResource ContentFontSize}" FontFamily="{StaticResource ContentFont}" Closed="LogInLogOutContextMenu_Closed" Opened="LogInLogOutContextMenu_Opened">
								<MenuItem x:Name="LogInLogOutMenuItem" Visibility="{Binding VisibilityWhenUserIsNotElevated}" Header="{Binding LoginLogoutCommandText}" Command="{Binding LoginLogoutCommand}" Margin="0,16,0,11">
									<ToolTipService.ToolTip>
										<TextBlock Text="{Binding LoginLogoutCommand.SemiconductorModuleCommandToolTipText}"/>
									</ToolTipService.ToolTip>
								</MenuItem>
								<Separator Margin="0,0,0,8" Visibility="{Binding VisibilityWhenUserCanElevate}"/>
								<!-- If the user is elevated, require them to revert privileges to the original user instead of logging out.
							This requires a custom event handler instead of binding directly to LoginLogoutCommand. -->
								<MenuItem x:Name="RevertUserMenuItem" Header="REVERT_USER" Click="RevertUser_Click" Margin="0,16,0,11" Visibility="{Binding VisibilityWhenUserIsElevated}" />
								<MenuItem x:Name="ElevateUserMenuItem" Header="ELEVATE_USER" Margin="0,16,0,11" Visibility="{Binding VisibilityWhenUserCanElevate}" Click="AnimateLoginPrompt" StaysOpenOnClick="True" />
								<MenuItem x:Name="EnterCredentialsMenuItem" MaxHeight="0" StaysOpenOnClick="True">
									<MenuItem.Template>
										<!-- Have to override the ControlTemplate so that the background does not change on mouseover -->
										<ControlTemplate TargetType="MenuItem">
											<Border Background="{TemplateBinding Background}">
												<ContentPresenter Content="{TemplateBinding Header}" />
											</Border>
										</ControlTemplate>
									</MenuItem.Template>
									<MenuItem.Header>
										<StackPanel Width="300" Margin="10" KeyDown="OnEnterCredentialsKeyDown">
											<TextBlock x:Name="UserLabel" Text="USER" />
											<TextBox x:Name="UserNameBox"/>
											<TextBlock x:Name="PasswordLabel" Text="PASSWORD"/>
											<PasswordBox x:Name="PasswordBox" />
											<TextBlock x:Name="InvalidMessage" Visibility="Hidden" Text="INVALID_PASSWORD" Margin="0,4" TextWrapping="Wrap" Foreground="Red" MaxWidth="275"/>
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
												<Button x:Name="ElevateUserButton" Margin="5,0" Click="ElevateUser_Click">
													<Button.Content>
														<Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,1" BorderThickness="0.5" BorderBrush="{StaticResource TextColor}">
															<TextBlock Text="OK" Foreground="{StaticResource TextColor}" FontSize="10pt" Margin="0,0,0,2" Width="50" TextAlignment="Center"/>
														</Border>
													</Button.Content>
												</Button>
											</StackPanel>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
							</ContextMenu>
						</Button.ContextMenu>
					</Button>
				</Grid>
			</Grid>

			<Grid Grid.Row="1" Grid.IsSharedSizeScope="True" x:Name="MainGrid" IsEnabled="{Binding LoggedIn}" IsEnabledChanged="MainGrid_IsEnabledChanged">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="{Binding Path=DesiredSize.Width, ElementName=YieldCard}"/>
					<ColumnDefinition Width="*" MinWidth="{Binding Path=DesiredSize.Width, ElementName=TimeCard}"/>
					<ColumnDefinition Width="*" MinWidth="{Binding Path=DesiredSize.Width, ElementName=TestSettingsCard}"/>
				</Grid.ColumnDefinitions>

				<!-- TestStand Manager Controls -->
				<WindowsFormsHost Name="ApplicationManagerHost" Visibility="Collapsed" />
				<WindowsFormsHost Name="SequenceFileViewManagerHost" Visibility="Collapsed" />

				<Grid Grid.Row="0" Grid.Column="0" x:Name="YieldCard" Margin="0,0,64,0" MinHeight="{StaticResource MinCardHeight}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" MinHeight="40"/>
						<RowDefinition Height="{StaticResource RowHeight}"/>
						<RowDefinition Height="{Binding WaferRowHeight}" />
						<RowDefinition Height="{StaticResource RowHeight}"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="70" />
						<ColumnDefinition Width="Auto" MinWidth="80" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Rectangle Grid.Row="0" Grid.ColumnSpan="3" Height="{StaticResource DividerHeight}" Fill="{StaticResource FrameColor}" Margin="{StaticResource CardDividerMargin}" />
					<TextBlock Name="YieldLabel" Foreground="{StaticResource TextColor}" Grid.Row="1" Grid.Column="0" Text="YIELD" FontSize="{StaticResource SectionLabelSize}" FontFamily="{DynamicResource SectionLabelFont}" Margin="{StaticResource CardLabelMargin}"/>
					<TextBlock Name="LotLabel" Text="LOT" Foreground="{StaticResource TextColor}" Grid.Row="2" Grid.Column="0" Margin="{StaticResource CardSubLabelMargin}" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Bottom"/>
					<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
						<TextBlock Text="{Binding AllSitePartCountStatistics.Yield, StringFormat={}{0:0}}" LineHeight="1" LineStackingStrategy="BlockLineHeight" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource AllSiteStatisticsFontSize}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
						<TextBlock Name="LotPercentLabel" Text="BIN_PERCENTAGE" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" LineHeight="1" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
					</StackPanel>
					<StackPanel Grid.Row="2" Grid.Column="2" Margin="{StaticResource SliderColumnMargin}" VerticalAlignment="Bottom">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<StackPanel.Resources>
								<Style TargetType="TextBlock">
									<Setter Property="FontFamily" Value="{StaticResource ContentFont}" />
									<Setter Property="FontSize" Value="{StaticResource ContentFontSizeSmall}" />
									<Setter Property="Foreground" Value="{StaticResource TextColor}" />
								</Style>
							</StackPanel.Resources>
							<TextBlock Text="{Binding AllSitePartCountStatistics.Passed}" />
							<TextBlock Text=" " />
							<TextBlock Name="LotPassedLabel" Text="PASSED" />
							<TextBlock Text=" / " />
							<TextBlock Text="{Binding AllSitePartCountStatistics.Total}" />
							<TextBlock Text=" " />
							<TextBlock Name="LotTestedLabel" Text="TESTED" />
						</StackPanel>
						<local:SemiconductorModuleSlider Value="{Binding AllSitePartCountStatistics.Yield}" />
					</StackPanel>

					<TextBlock Name="WaferLabel" Text="WAFER" Grid.Row="3" Grid.Column="0" Margin="{StaticResource CardSubLabelMargin}" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Bottom" Visibility="{Binding WaferVisibility}"/>
					<StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding WaferVisibility}">
						<TextBlock Text="{Binding WaferPartCountStatistics.Yield, StringFormat={}{0:0}}" LineHeight="1" LineStackingStrategy="BlockLineHeight" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource AllSiteStatisticsFontSize}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
						<TextBlock Name="WaferPercentLabel" Text="BIN_PERCENTAGE" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" LineHeight="1" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom" Margin="0,0,0,8" />
					</StackPanel>
					<StackPanel Grid.Row="3" Grid.Column="2" Margin="8,0,0,8" VerticalAlignment="Bottom" Visibility="{Binding WaferVisibility}">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<StackPanel.Resources>
								<Style TargetType="TextBlock">
									<Setter Property="FontFamily" Value="{StaticResource ContentFont}" />
									<Setter Property="FontSize" Value="{StaticResource ContentFontSizeSmall}" />
									<Setter Property="Foreground" Value="{StaticResource TextColor}" />
								</Style>
							</StackPanel.Resources>
							<TextBlock Text="{Binding WaferPartCountStatistics.Passed}" />
							<TextBlock Text=" " />
							<TextBlock Name="WaferPassedLabel" Text="PASSED" />
							<TextBlock Text=" / " />
							<TextBlock Text="{Binding WaferPartCountStatistics.Total}" />
							<TextBlock Text=" " />
							<TextBlock Name="WaferTestedLabel" Text="TESTED" />
						</StackPanel>
						<local:SemiconductorModuleSlider Value="{Binding WaferPartCountStatistics.Yield}" />
					</StackPanel>

					<TextBlock Name="LastNLabel" Text="{Binding LastNString}" Grid.Row="4" Grid.Column="0" Margin="{StaticResource CardSubLabelMargin}" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Bottom" />
					<StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
						<TextBlock Text="{Binding WindowSitePartCountStatistics.Yield, StringFormat={}{0:0}}" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource AllSiteStatisticsFontSize}" VerticalAlignment="Bottom" Margin="0,0,0,8" LineHeight="1" LineStackingStrategy="BlockLineHeight"/>
						<TextBlock Name="LastNPercentLabel" Text="BIN_PERCENTAGE" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" VerticalAlignment="Bottom" Margin="0,0,0,8" LineHeight="1" LineStackingStrategy="BlockLineHeight"/>
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="2" Margin="8,0,0,8" VerticalAlignment="Bottom">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<StackPanel.Resources>
								<Style TargetType="TextBlock">
									<Setter Property="FontFamily" Value="{StaticResource ContentFont}" />
									<Setter Property="FontSize" Value="{StaticResource ContentFontSizeSmall}" />
									<Setter Property="Foreground" Value="{StaticResource TextColor}" />
								</Style>
							</StackPanel.Resources>
							<TextBlock Text="{Binding WindowSitePartCountStatistics.Passed}" />
							<TextBlock Text=" " />
							<TextBlock Name="WindowPassedLabel" Text="PASSED" />
							<TextBlock Text=" / " />
							<TextBlock Text="{Binding WindowSitePartCountStatistics.Total}" />
							<TextBlock Text=" " />
							<TextBlock Name="WindowTestedLabel" Text="TESTED" />
						</StackPanel>
						<local:SemiconductorModuleSlider Value="{Binding WindowSitePartCountStatistics.Yield}" />
					</StackPanel>
				</Grid>
				<Grid Grid.Row="0" Grid.Column="1" x:Name="TimeCard" Margin="0,0,64,0" MinHeight="{StaticResource MinCardHeight}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" MinHeight="40"/>
						<RowDefinition Height="{StaticResource RowHeight}"/>
						<RowDefinition Height="{StaticResource RowHeight}"/>
						<RowDefinition Height="{StaticResource RowHeight}"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" MinWidth="70" />
						<ColumnDefinition Width="Auto" MinWidth="80" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Rectangle Grid.Row="0" Grid.ColumnSpan="3" Fill="{StaticResource FrameColor}" Height="{StaticResource DividerHeight}" Margin="{StaticResource CardDividerMargin}" />
					<TextBlock x:Name="TimeLabel" Grid.Row="1" Grid.Column="0" Text="TIME" FontSize="{StaticResource SectionLabelSize}" FontFamily="{StaticResource SectionLabelFont}" Margin="{StaticResource CardLabelMargin}"/>
					<TextBlock Name="SocketTimeLabel" Text="SOCKET" Grid.Row="2" Grid.Column="0" Margin="{StaticResource CardSubLabelMargin}" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Bottom"/>
					<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
						<TextBlock Text="{Binding AverageSocketTime, StringFormat={}{0:0}}" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource AllSiteStatisticsFontSize}" VerticalAlignment="Bottom" Margin="0,0,0,8" LineHeight="1" LineStackingStrategy="BlockLineHeight"/>
						<TextBlock Name="SocketTimeUnitsLabel" Text="UNIT_MILLISECONDS" FontFamily="{StaticResource DataContentFont}" FontSize="{StaticResource ContentFontSizeSmall}" VerticalAlignment="Bottom" Margin="0,0,0,8" LineHeight="1" LineStackingStrategy="BlockLineHeight"/>
					</StackPanel>
					<local:SemiconductorModuleSlider Grid.Row="2" Grid.Column="2" x:Name="SocketTimeSlider" Value="{Binding AverageSocketTime}" MaxValue="{Binding TimingSliderMaximum}" 
											VerticalAlignment="Bottom" Margin="{StaticResource SliderColumnMargin}" />

					<TextBlock Name="IndexTimeLabel" Text="INDEX" Grid.Row="3" Grid.Column="0" Margin="{StaticResource CardSubLabelMargin}" FontFamily="{StaticResource ContentFont}" FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Bottom"/>
					<StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
